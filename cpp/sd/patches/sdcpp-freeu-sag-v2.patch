diff --git a/src/core/ggml_fourier.h b/src/core/ggml_fourier.h
new file mode 100644
index 0000000..0a5fdff
--- /dev/null
+++ b/src/core/ggml_fourier.h
@@ -0,0 +1,185 @@
+#ifndef __SD_CORE_GGML_FOURIER_H__
+#define __SD_CORE_GGML_FOURIER_H__
+
+// =============================================================================
+// FreeU（本项目 patch）— 对应 ComfyUI comfy_extras/nodes_freelunch.py::FreeU_V2
+//
+// 两部分：
+//   1. skip 连接的频域调制 ggml_ext_fourier_filter_lowfreq（见下方注释）；
+//   2. backbone 前半通道的动态缩放 ggml_ext_freeu_v2_backbone。
+//
+// Fourier_filter 1:1 复刻 ComfyUI：
+//     x_freq = fftshift(fftn(x.float(), dim=(-2, -1)))
+//     mask[..., crow-t : crow+t, ccol-t : ccol+t] = scale
+//     return ifftn(ifftshift(x_freq * mask)).real.to(x.dtype)
+// ComfyUI 只用 threshold=1，即把 fftshift 后频谱中心 2x2（频率 {-1,0} x {-1,0}）
+// 的 4 个 DFT bin 乘以 scale，其余 bin 不变 —— 用来压掉 skip 连接里的低频。
+//
+// 这里不做 FFT，改用完全等价的闭式投影（threshold=1 时中心块只有 4 个 bin）：
+//     x' = x + (scale - 1) * Re{P(x)}
+//     Re{P} = 1/(H*W) * [ S00 + (Cθ·cosθ + Sθ·sinθ) + (Cφ·cosφ + Sφ·sinφ)
+//                        + (Cθφ·cos(θ+φ) + Sθφ·sin(θ+φ)) ]
+// 其中 θ = 2πi/H、φ = 2πj/W，C/S 是 x 在对应频率上的 DFT 系数实部/虚部。
+// 复杂度 O(H*W*C)：几个 elementwise + 两次规约，不需要 ggml 引入 FFT 算子。
+//
+// 张量布局按 ggml 约定 ne0=W（torch 最后一维）、ne1=H、ne2=C、ne3=B，
+// 与 torch (B, C, H, W) 的 dim(-2,-1) = (H, W) 一一对应。
+// =============================================================================
+
+#include "ggml.h"
+
+// ggml_permute 的参数是「源轴 i 放到哪个目标轴」：permute(a, d0, d1, d2, d3) => ne[d_i] = a->ne[i]。
+
+// 空间求和（ne0 x ne1），保留通道：[W,H,C,N] -> [1,1,C,N]
+inline static ggml_tensor* ggml_ext_sum_spatial(ggml_context* ctx,
+                                                ggml_tensor*  x) {
+    ggml_tensor* p = ggml_cont(ctx, x);                                // [W,H,C,N]
+    p              = ggml_cont(ctx, ggml_permute(ctx, p, 1, 0, 2, 3)); // [H,W,C,N]
+    p              = ggml_sum_rows(ctx, p);                            // [1,W,C,N]
+    p              = ggml_cont(ctx, ggml_permute(ctx, p, 1, 0, 2, 3)); // [W,1,C,N]
+    return ggml_sum_rows(ctx, p);                                      // [1,1,C,N]
+}
+
+// 对通道维（ne2）取均值：[W,H,C,N] -> [W,H,1,N]（对应 torch h.mean(1)，h 为 [B,C,H,W]）
+inline static ggml_tensor* ggml_ext_mean_channels(ggml_context* ctx, ggml_tensor* x) {
+    ggml_tensor* p = ggml_cont(ctx, x);                                // [W,H,C,N]
+    p              = ggml_cont(ctx, ggml_permute(ctx, p, 1, 2, 0, 3)); // [C,W,H,N]
+    p              = ggml_sum_rows(ctx, p);                            // [1,W,H,N]
+    p              = ggml_cont(ctx, ggml_permute(ctx, p, 2, 0, 1, 3)); // [W,H,1,N]
+    return ggml_scale(ctx, p, 1.0f / (float)x->ne[2]);
+}
+
+// 空间维（ne0 x ne1）全局最大，逐 (C,N)：[W,H,C,N] -> [1,1,C,N]
+inline static ggml_tensor* ggml_ext_global_max_spatial(ggml_context* ctx, ggml_tensor* x) {
+    x            = ggml_cont(ctx, x);
+    const int k0 = (int)x->ne[0];
+    const int k1 = (int)x->ne[1];
+    return ggml_pool_2d(ctx, x, GGML_OP_POOL_MAX, k0, k1, k0, k1, 0.0f, 0.0f);
+}
+
+// FreeU_V2 的 backbone 缩放：h[:, :ch//2] *= (b-1) * hidden_mean + 1，
+// hidden_mean 是通道均值在空间维按 min/max 归一化到 [0,1] 的结果
+// （1:1 复刻 comfy_extras/nodes_freelunch.py::FreeU_V2 的 output_block_patch 前半段）。
+// 返回拼接后的同形张量；b == 1 或通道数 < 2 时原样返回。
+inline static ggml_tensor* ggml_ext_freeu_v2_backbone(ggml_context* ctx,
+                                                      ggml_tensor*  h,
+                                                      float         b) {
+    const int64_t ch     = h->ne[2];
+    const int64_t half_c = ch / 2;
+    if (b == 1.0f || half_c <= 0) {
+        return h;
+    }
+    // 均值/池化在 f32 下算，最后转回原 dtype
+    const enum ggml_type src_type = h->type;
+    ggml_tensor*         hf       = (src_type == GGML_TYPE_F32) ? h : ggml_cast(ctx, h, GGML_TYPE_F32);
+    hf                             = ggml_cont(ctx, hf);
+
+    // hidden_mean 在空间维归一化：(hm - min) / (max - min)，随后 factor = (b-1)*hidden_mean + 1
+    // 改写成 [span + (b-1)*(hm - min)] / span，避免引入常量张量（span == 0 时与 torch 一样得 NaN）
+    ggml_tensor* hm    = ggml_ext_mean_channels(ctx, hf);                 // [W,H,1,N]
+    ggml_tensor* hmax  = ggml_ext_global_max_spatial(ctx, hm);            // [1,1,1,N]
+    ggml_tensor* hmin  = ggml_scale(ctx,
+                                    ggml_ext_global_max_spatial(ctx, ggml_scale(ctx, hm, -1.0f)),
+                                    -1.0f);                                // [1,1,1,N]
+    ggml_tensor* span  = ggml_sub(ctx, hmax, hmin);                       // [1,1,1,N]
+    ggml_tensor* scale = ggml_div(ctx,
+                                  ggml_add(ctx,
+                                           ggml_scale(ctx, ggml_sub(ctx, hm, hmin), b - 1.0f),
+                                           span),
+                                  span);                                   // [W,H,1,N]
+
+    ggml_tensor* h_first  = ggml_cont(ctx, ggml_view_4d(ctx,
+                                                        hf,
+                                                        hf->ne[0],
+                                                        hf->ne[1],
+                                                        half_c,
+                                                        hf->ne[3],
+                                                        hf->nb[1],
+                                                        hf->nb[2],
+                                                        hf->nb[3],
+                                                        0));
+    h_first               = ggml_mul(ctx, h_first, scale);
+    ggml_tensor* h_second = ggml_cont(ctx, ggml_view_4d(ctx,
+                                                        hf,
+                                                        hf->ne[0],
+                                                        hf->ne[1],
+                                                        ch - half_c,
+                                                        hf->ne[3],
+                                                        hf->nb[1],
+                                                        hf->nb[2],
+                                                        hf->nb[3],
+                                                        half_c * hf->nb[2]));
+    ggml_tensor* out      = ggml_concat(ctx, h_first, h_second, 2);
+    if (src_type != GGML_TYPE_F32) {
+        out = ggml_cast(ctx, out, src_type);
+    }
+    return out;
+}
+
+// FreeU 的 skip 频域调制，见文件头注释。
+// threshold 只支持 1（ComfyUI FreeU/FreeU_V2 唯一取值）；scale == 1 时原样返回。
+inline static ggml_tensor* ggml_ext_fourier_filter_lowfreq(ggml_context* ctx,
+                                                           ggml_tensor*  x,
+                                                           float         scale,
+                                                           int           threshold = 1) {
+    GGML_ASSERT(threshold == 1 && "ggml_ext_fourier_filter_lowfreq: only threshold=1 is supported");
+    if (scale == 1.0f) {
+        return x;
+    }
+
+    const enum ggml_type src_type = x->type;
+    ggml_tensor*         xf       = (src_type == GGML_TYPE_F32) ? x : ggml_cast(ctx, x, GGML_TYPE_F32);
+    xf                             = ggml_cont(ctx, xf);
+
+    const int64_t W      = xf->ne[0];
+    const int64_t H      = xf->ne[1];
+    const float   kTwoPi = 6.28318530717959f;
+
+    // 频率基：theta = 2πi/H（ne1 方向）、phi = 2πj/W（ne0 方向）
+    ggml_tensor* theta = ggml_arange(ctx, 0.0f, (float)H, 1.0f);
+    theta              = ggml_reshape_4d(ctx, ggml_scale(ctx, theta, kTwoPi / (float)H), 1, H, 1, 1);
+    ggml_tensor* phi   = ggml_arange(ctx, 0.0f, (float)W, 1.0f);
+    phi                = ggml_reshape_4d(ctx, ggml_scale(ctx, phi, kTwoPi / (float)W), W, 1, 1, 1);
+
+    ggml_tensor* cos_i = ggml_cos(ctx, theta);  // [1,H,1,1]
+    ggml_tensor* sin_i = ggml_sin(ctx, theta);  // [1,H,1,1]
+    ggml_tensor* cos_j = ggml_cos(ctx, phi);    // [W,1,1,1]
+    ggml_tensor* sin_j = ggml_sin(ctx, phi);    // [W,1,1,1]
+
+    // 全尺寸基（结果要落回 [W,H,C,N]，用它们当 mul 的左操作数即可免去后续 repeat）
+    ggml_tensor* ci = ggml_repeat(ctx, cos_i, xf);
+    ggml_tensor* si = ggml_repeat(ctx, sin_i, xf);
+    ggml_tensor* cj = ggml_repeat(ctx, cos_j, xf);
+    ggml_tensor* sj = ggml_repeat(ctx, sin_j, xf);
+
+    // cos(θ+φ) = cosθcosφ - sinθsinφ ； sin(θ+φ) = sinθcosφ + cosθsinφ
+    ggml_tensor* ct = ggml_sub(ctx, ggml_mul(ctx, ci, cj), ggml_mul(ctx, si, sj));
+    ggml_tensor* st = ggml_add(ctx, ggml_mul(ctx, si, cj), ggml_mul(ctx, ci, sj));
+
+    // 各频率上的 DFT 系数（逐通道标量）[1,1,C,N]
+    ggml_tensor* w00 = ggml_ext_sum_spatial(ctx, xf);
+    ggml_tensor* wci = ggml_ext_sum_spatial(ctx, ggml_mul(ctx, xf, cos_i));
+    ggml_tensor* wsi = ggml_ext_sum_spatial(ctx, ggml_mul(ctx, xf, sin_i));
+    ggml_tensor* wcj = ggml_ext_sum_spatial(ctx, ggml_mul(ctx, xf, cos_j));
+    ggml_tensor* wsj = ggml_ext_sum_spatial(ctx, ggml_mul(ctx, xf, sin_j));
+    ggml_tensor* wct = ggml_ext_sum_spatial(ctx, ggml_mul(ctx, xf, ct));
+    ggml_tensor* wst = ggml_ext_sum_spatial(ctx, ggml_mul(ctx, xf, st));
+
+    // Re{P(x)}
+    ggml_tensor* p = ggml_add(ctx, ggml_repeat(ctx, w00, xf), ggml_mul(ctx, ci, wci));
+    p              = ggml_add(ctx, p, ggml_mul(ctx, si, wsi));
+    p              = ggml_add(ctx, p, ggml_mul(ctx, cj, wcj));
+    p              = ggml_add(ctx, p, ggml_mul(ctx, sj, wsj));
+    p              = ggml_add(ctx, p, ggml_mul(ctx, ct, wct));
+    p              = ggml_add(ctx, p, ggml_mul(ctx, st, wst));
+    p              = ggml_scale(ctx, p, 1.0f / (float)(W * H));
+
+    ggml_tensor* out = ggml_add(ctx, xf, ggml_scale(ctx, p, scale - 1.0f));
+
+    if (src_type != GGML_TYPE_F32) {
+        out = ggml_cast(ctx, out, src_type);
+    }
+    return out;
+}
+
+#endif  // __SD_CORE_GGML_FOURIER_H__
