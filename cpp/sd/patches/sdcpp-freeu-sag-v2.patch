diff --git a/src/model/diffusion/gligen.hpp b/src/model/diffusion/gligen.hpp
new file mode 100644
index 0000000..011c0ef
--- /dev/null
+++ b/src/model/diffusion/gligen.hpp
@@ -0,0 +1,136 @@
+#ifndef __GLIGEN_HPP__
+#define __GLIGEN_HPP__
+
+// GLIGEN（本项目 patch）：gated self-attention 注入 UNet transformer 块。
+// 参照 ComfyUI comfy/gligen.py：
+//   GatedSelfAttentionDense / PositionNet / Gligen
+#include <cmath>
+#include <string>
+#include <vector>
+
+#include "model/common/block.hpp"
+
+struct GatedSelfAttentionDense : public GGMLBlock {
+protected:
+    int64_t query_dim;
+    int64_t context_dim;
+    int64_t n_head;
+    int64_t d_head;
+
+public:
+    // alpha_attn / alpha_dense：checkpoint 标量，由加载器读入（默认 0 → 不生效）
+    float alpha_attn  = 0.0f;
+    float alpha_dense = 0.0f;
+
+    GatedSelfAttentionDense(int64_t query_dim,
+                            int64_t context_dim,
+                            int64_t n_head,
+                            int64_t d_head)
+        : query_dim(query_dim),
+          context_dim(context_dim),
+          n_head(n_head),
+          d_head(d_head) {
+        blocks["linear"] = std::shared_ptr<GGMLBlock>(new Linear(context_dim, query_dim));
+        blocks["attn"]   = std::shared_ptr<GGMLBlock>(new CrossAttention(query_dim, query_dim, n_head, d_head));
+        blocks["ff"]     = std::shared_ptr<GGMLBlock>(new FeedForward(query_dim, query_dim));
+        blocks["norm1"]  = std::shared_ptr<GGMLBlock>(new LayerNorm(query_dim));
+        blocks["norm2"]  = std::shared_ptr<GGMLBlock>(new LayerNorm(query_dim));
+    }
+
+    ggml_tensor* forward(GGMLRunnerContext* ctx, ggml_tensor* x, ggml_tensor* objs) {
+        // x:    [N, n_visual, query_dim]
+        // objs: [N, n_ground, query_dim]
+        auto linear = std::dynamic_pointer_cast<Linear>(blocks["linear"]);
+        auto attn   = std::dynamic_pointer_cast<CrossAttention>(blocks["attn"]);
+        auto ff     = std::dynamic_pointer_cast<FeedForward>(blocks["ff"]);
+        auto norm1  = std::dynamic_pointer_cast<LayerNorm>(blocks["norm1"]);
+        auto norm2  = std::dynamic_pointer_cast<LayerNorm>(blocks["norm2"]);
+
+        int64_t n_visual = x->ne[1];
+
+        objs = linear->forward(ctx, objs);                             // [N, n_ground, query_dim]
+        auto xc = ggml_concat(ctx->ggml_ctx, x, objs, 1);              // [N, n_visual+n_ground, query_dim]
+        xc      = norm1->forward(ctx, xc);
+        auto a  = attn->forward(ctx, xc, xc);                          // self-attention over concat
+
+        // 取前 n_visual 个 token
+        auto a_vis = ggml_view_3d(ctx->ggml_ctx,
+                                  a,
+                                  a->ne[0],
+                                  n_visual,
+                                  a->ne[2],
+                                  a->nb[1],
+                                  a->nb[2],
+                                  0);
+        a_vis      = ggml_cont(ctx->ggml_ctx, a_vis);
+
+        float sa = std::tanh(alpha_attn);
+        float sd = std::tanh(alpha_dense);
+
+        x = ggml_add(ctx->ggml_ctx, x, ggml_scale(ctx->ggml_ctx, a_vis, sa));
+
+        auto f = ff->forward(ctx, norm2->forward(ctx, x));
+        x      = ggml_add(ctx->ggml_ctx, x, ggml_scale(ctx->ggml_ctx, f, sd));
+        return x;
+    }
+};
+
+struct PositionNet : public GGMLBlock {
+protected:
+    int64_t in_dim;
+    int64_t out_dim;
+    int64_t fourier_freqs;
+    int64_t position_dim;
+
+public:
+    PositionNet(int64_t in_dim, int64_t out_dim, int64_t fourier_freqs = 8)
+        : in_dim(in_dim),
+          out_dim(out_dim),
+          fourier_freqs(fourier_freqs),
+          position_dim(fourier_freqs * 2 * 4) {
+        blocks["linears.0"] = std::shared_ptr<GGMLBlock>(new Linear(in_dim + position_dim, 512));
+        blocks["linears.2"] = std::shared_ptr<GGMLBlock>(new Linear(512, 512));
+        blocks["linears.4"] = std::shared_ptr<GGMLBlock>(new Linear(512, out_dim));
+    }
+
+    // 由适配层预计算 Fourier 位置特征后传入；此处只做 MLP
+    // positive_embeddings: [N, n_objs, in_dim]
+    // pos_features:        [N, n_objs, position_dim]
+    ggml_tensor* forward(GGMLRunnerContext* ctx, ggml_tensor* positive_embeddings, ggml_tensor* pos_features) {
+        auto l0 = std::dynamic_pointer_cast<Linear>(blocks["linears.0"]);
+        auto l2 = std::dynamic_pointer_cast<Linear>(blocks["linears.2"]);
+        auto l4 = std::dynamic_pointer_cast<Linear>(blocks["linears.4"]);
+
+        auto x = ggml_concat(ctx->ggml_ctx, positive_embeddings, pos_features, 0);  // [N, n_objs, in+pos]
+        x      = l0->forward(ctx, x);
+        x      = ggml_silu_inplace(ctx->ggml_ctx, x);
+        x      = l2->forward(ctx, x);
+        x      = ggml_silu_inplace(ctx->ggml_ctx, x);
+        x      = l4->forward(ctx, x);
+        return x;
+    }
+};
+
+// 供 UNet transformer 块回调（transformer_index 对应 modules 下标）
+struct GligenModules : public GligenApplier {
+    std::vector<std::shared_ptr<GatedSelfAttentionDense>> modules;
+
+    ggml_tensor* apply(GGMLRunnerContext* ctx, ggml_tensor* x, int index) override {
+        if (index < 0 || index >= (int)modules.size()) {
+            return x;
+        }
+        auto& m = modules[index];
+        if (m == nullptr) {
+            return x;
+        }
+        return m->forward(ctx, x, ctx->gligen_objs);
+    }
+};
+
+struct Gligen {
+    std::shared_ptr<GligenModules> modules;
+    std::shared_ptr<PositionNet> position_net;
+    int64_t key_dim = 768;
+};
+
+#endif  // __GLIGEN_HPP__
