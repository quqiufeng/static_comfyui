new file mode 100644
index 0000000..4378dce
--- /dev/null
+++ b/src/runtime/freq_filter.h
@@ -0,0 +1,115 @@
+#ifndef __SD_RUNTIME_FREQ_FILTER_H__
+#define __SD_RUNTIME_FREQ_FILTER_H__
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <vector>
+
+// FreSca 频域 guidance 增强（本项目 patch）
+// 复刻 ComfyUI comfy_extras/nodes_fresca.py Fourier_filter：
+//   x_freq = fftshift(fftn(x, dim=(-2,-1)))
+//   mask   = scale_high，中心盒 [cc-f_c, cc+f_c) 置 scale_low
+//            （每轴 cc = n//2, f_c = min(freq_cutoff, cc)）
+//   x_out  = real(ifftn(ifftshift(mask * x_freq)))
+//
+// 等价闭式：x_out = scale_high*x + (scale_low - scale_high) * Re{IDFT(box·DFT(x))}
+// 其中 box = 频率 k ∈ [-f_c, f_c-1]（fftshift 盒映回未移位坐标）。
+// 掩码可分离（rect⊗rect），Re{IDFT} 拆成沿 W、沿 H 各一次 1D 圆卷积
+// （复 Dirichlet 核 g[j] = (1/N)·Σ_{k=-T}^{T-1} e^{i2πkj/N}），
+// 免 FFT：O(planes·(H·W² + W·H²))，仅对实张量生效（取 Re）。
+namespace sd::guidance {
+
+// data: 行主序连续张量，numel = planes*H*W（最后两维为空间轴，与 fftn(dim=(-2,-1)) 对齐）
+inline void freq_band_filter(float*  data,
+                             int64_t planes,
+                             int64_t H,
+                             int64_t W,
+                             float   scale_low,
+                             float   scale_high,
+                             int     freq_cutoff) {
+    if (data == nullptr || planes <= 0 || H <= 0 || W <= 0) return;
+
+    const float delta = scale_low - scale_high;
+    if (delta == 0.0f) {
+        // 均匀掩码 → 整体缩放
+        const int64_t n = planes * H * W;
+        for (int64_t i = 0; i < n; ++i) data[i] *= scale_low;
+        return;
+    }
+
+    const int T_h = std::min(freq_cutoff, (int)(H / 2));
+    const int T_w = std::min(freq_cutoff, (int)(W / 2));
+
+    // 每轴复核：T=0（f_c=0 或轴长 1）→ 全零 → 盒为空
+    auto make_kernel = [](int64_t n, int T, std::vector<double>& gre, std::vector<double>& gim) {
+        gre.assign((size_t)n, 0.0);
+        gim.assign((size_t)n, 0.0);
+        if (T <= 0) return;
+        const double inv_n = 1.0 / (double)n;
+        for (int64_t j = 0; j < n; ++j) {
+            double sr = 0.0, si = 0.0;
+            for (int k = -T; k <= T - 1; ++k) {
+                const double ang = 2.0 * M_PI * (double)k * (double)j * inv_n;
+                sr += std::cos(ang);
+                si += std::sin(ang);
+            }
+            gre[(size_t)j] = sr * inv_n;
+            gim[(size_t)j] = si * inv_n;
+        }
+    };
+
+    std::vector<double> gw_re, gw_im, gh_re, gh_im;
+    make_kernel(W, T_w, gw_re, gw_im);
+    make_kernel(H, T_h, gh_re, gh_im);
+
+    const int64_t hw       = H * W;
+    std::vector<double> yr((size_t)hw), yi((size_t)hw), ur((size_t)hw);
+
+    for (int64_t p = 0; p < planes; ++p) {
+        const float* xp = data + p * hw;
+
+        // Pass 1：沿 W 行圆卷积（复核，实/虚部分存）
+        for (int64_t i = 0; i < H; ++i) {
+            const float* row = xp + i * W;
+            double*      yrp = yr.data() + i * W;
+            double*      yip = yi.data() + i * W;
+            for (int64_t n = 0; n < W; ++n) {
+                double sr = 0.0, si = 0.0;
+                for (int64_t m = 0; m < W; ++m) {
+                    const int64_t j   = n - m;
+                    const int64_t idx = j >= 0 ? j : j + W;
+                    const double  xv  = (double)row[m];
+                    sr += gw_re[(size_t)idx] * xv;
+                    si += gw_im[(size_t)idx] * xv;
+                }
+                yrp[n] = sr;
+                yip[n] = si;
+            }
+        }
+
+        // Pass 2：沿 H 列圆卷积取实部：Re{g_h ⊛ y} = Re(g_h)⊛Re(y) − Im(g_h)⊛Im(y)
+        for (int64_t j = 0; j < W; ++j) {
+            for (int64_t n = 0; n < H; ++n) {
+                double sr = 0.0;
+                for (int64_t m = 0; m < H; ++m) {
+                    const int64_t j0  = n - m;
+                    const int64_t idx = j0 >= 0 ? j0 : j0 + H;
+                    sr += gh_re[(size_t)idx] * yr[(size_t)m * W + j] -
+                          gh_im[(size_t)idx] * yi[(size_t)m * W + j];
+                }
+                ur[(size_t)n * W + j] = sr;
+            }
+        }
+
+        // 合成：out = scale_high*x + delta*u
+        float* op = data + p * hw;
+        for (int64_t i = 0; i < hw; ++i) {
+            op[i] = (float)((double)scale_high * (double)xp[i] + (double)delta * ur[(size_t)i]);
+        }
+    }
+}
+
+}  // namespace sd::guidance
+
+#endif  // __SD_RUNTIME_FREQ_FILTER_H__
